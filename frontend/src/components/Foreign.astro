---
import { crumbCls, emptyCls } from '../lib/ui';
// A foreign ship: an outside model read on Thorp's decks, shown in the Market Harbour so it can be spied on.
// Read-only: it is not a Thorp size or ship, and there is no spec or run behind it.
---
<div class="section" id="foreign">
  <h1><a class={crumbCls('back')} href="/harbours/zayton">← Zayton</a> <span id="foreigntitle"></span> <span class="q" id="foreignsub"></span></h1>
  <div id="foreignbody"><div class={emptyCls()}>reading the foreign ship…</div></div>
</div>
