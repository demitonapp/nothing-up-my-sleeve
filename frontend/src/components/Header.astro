---
// The shared header: the wordmark, the "updated" stamp, the five ways in, and the settings cog. The tabs themselves
// are the shared row (Tabs.astro), and their order, labels and active rule live in lib/nav.ts, so
// the header and every page's section tabs cannot disagree (UI.md, "Navigation").
import Tabs from './Tabs.astro';
import { MAIN_TABS, mainTabFor, navPath } from '../lib/nav';

// settings is not one of the ways in: on it (and on any of its tabs) the cog is lit and no tab is
const onSettings = (p: string): boolean => p === '/settings' || p.startsWith('/settings/');
const atSettings = onSettings(navPath(Astro.url.pathname));
const active = atSettings ? null : mainTabFor(Astro.url.pathname);
const items = MAIN_TABS.map((t) => ({
  key: t.key,
  label: t.label,
  href: t.href,
  title: t.title,
  active: t.key === active,
  // the header's script re-lights the row after an island pushes a new address
  data: { 'data-match': t.match.join(',') },
}));
---
<header>
  <h1><a href="/harbours" id="home" title="the harbours"><img class="brandmark" src="/card.svg" alt="" width="20" height="20" />Nothing up my sleeve</a></h1>
  <span class="sub" id="updated"></span>
  <!-- the ways in: the ships, grouped by size, the expeditions they have made, and the discoveries
       followed across all of them (UI.md, "Navigation") -->
  <Tabs items={items} variant="default" id="mainnav" class="ml-auto" ariaLabel="Main" />
  <!-- the palette's way in, for anyone who does not know the shortcut yet (⌘K) -->
  <button class="cog" id="palettebtn" type="button" title="chat to a model (⌘K)" aria-label="chat to a model (Command K)" style="background:none;border:0;cursor:pointer;color:inherit;font:inherit;padding:0 6px;opacity:.75">
    <span class="mono" style="font-size:11px">⌘K</span>
  </button>
  <!-- settings: what the dashboard runs on (the disk, the store, the server, the switches) -->
  <a class="cog" id="settingscog" href="/settings" title="settings: storage, the store, the server, the switches and the keys" aria-label="Settings" aria-current={atSettings ? 'page' : undefined}>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
      <circle cx="12" cy="12" r="3" />
    </svg>
  </a>
</header>
<script is:inline>
  // the palette's button asks the island for the palette by name; the shortcut needs no button. Delegated
  // from the document so it survives a View Transition, which replaces the header element.
  document.addEventListener('click', (e) => {
    const b = e.target instanceof Element ? e.target.closest('#palettebtn') : null;
    if (b) window.dispatchEvent(new CustomEvent('thorp:palette'));
  });
</script>
