---
// The hull dimensions table: read from and written to s1.sizes through /api/hulls (9 November).
---
<section class="card panel" id="hullscard">
  <h2>Hull sizes <span class="note">each rung's shape: layers, width and heads, with the head width that follows (width ÷ heads). Set here and the change lands in Postgres, where the ladder reads it.</span></h2>
  <div id="hullstable"><span class="s">reading the hulls…</span></div>
</section>
<script>
  const box = document.getElementById('hullstable') as HTMLElement;
  const fmt = (n: number | null): string => (n == null ? '–' : n.toLocaleString());
  async function draw(): Promise<void> {
    const d = await (await fetch('/api/hulls')).json();
    const rows = (d.hulls || []).map((h: any) => `
      <tr data-preset="${h.preset}">
        <td><b>${h.preset}</b> <span class="s">${h.name || ''}</span></td>
        <td><input type="number" data-f="layers" value="${h.layers ?? ''}" min="1" max="64"></td>
        <td><input type="number" data-f="width" value="${h.width ?? ''}" min="8" step="8"></td>
        <td><input type="number" data-f="heads" value="${h.heads ?? ''}" min="1" max="32"></td>
        <td class="hdim">${fmt(h.head_dim)}</td>
        <td class="mono s">${fmt(h.vocab)}</td>
      </tr>`).join('');
    box.innerHTML = `<div class="scroll"><table class="hulltable"><thead><tr>
        <th>rung</th><th>layers</th><th>width</th><th>heads</th><th>head dim <span class="q">width ÷ heads</span></th><th>pieces</th>
      </tr></thead><tbody>${rows}</tbody></table></div>
      <div class="s">A width that no longer divides evenly into the heads is refused: the head width must be whole.</div>`;
    box.querySelectorAll<HTMLTableRowElement>('tr[data-preset]').forEach((tr) => {
      tr.querySelectorAll<HTMLInputElement>('input').forEach((inp) => {
        inp.onchange = async (): Promise<void> => {
          const q = new URLSearchParams({ preset: String(tr.dataset.preset) });
          tr.querySelectorAll<HTMLInputElement>('input').forEach((x) => q.set(x.dataset.f as string, x.value));
          const res = await fetch('/api/hulls/save?' + q.toString());
          const out: any = await res.json();
          if (!res.ok) { inp.style.borderColor = 'var(--red)'; return; }
          inp.style.borderColor = '';
          (tr.querySelector('.hdim') as HTMLElement).textContent = fmt(out.width / out.heads);
        };
      });
    });
  }
  draw();
</script>
<style>
  .hulltable input { width: 84px; }
  .hulltable .hdim { font-variant-numeric: tabular-nums; }
</style>
