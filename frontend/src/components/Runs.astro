---
import { cardCls, crumbCls } from '../lib/ui';
// every ship ever launched, of every size (#/ships); a row opens the ship
---
<div class="section" id="runs-section">
  <h1><a class={crumbCls('back')} href="/harbours">← harbours</a> Every ship <span class="q">every voyage on the ledger, of every size; open one to see it sail</span></h1>
  <section class={cardCls(false, 'panel')}>
    <div class="scroll"><table id="runs" class="clickable"><thead><tr>
      <th>ship</th><th>name</th><th>voyage</th><th>size</th><th>seed</th><th>status</th><th>tokens</th>
      <th>minutes</th><th>hole-card bpb mean</th><th>started</th></tr></thead><tbody></tbody></table></div>
  </section>
</div>
