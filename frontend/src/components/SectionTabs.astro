---
// The section tabs on a static page (the shipyard's constraints and hull sizes): the same row and
// the same active rule as SectionNav.tsx, resolved from the address at build time.
import Tabs from './Tabs.astro';
import { sectionNavFor } from '../lib/nav';

interface Props { path?: string }
const section = sectionNavFor(Astro.props.path || Astro.url.pathname);
---
{section && section.items.length > 1 ? (
  <Tabs
    items={section.items}
    variant="line"
    id={`${section.key}-nav`}
    class="subnav"
    ariaLabel={`${section.label} sections`}
  />
) : null}
