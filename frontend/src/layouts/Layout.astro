---
// The shared shell every page wraps itself in: the <head>, the global styles and the header nav
// (UI.md, "Navigation"). The multi-page split gives each route its own page; this layout is the one
// place the chrome lives. ClientRouter wires Astro's View Transitions so page-to-page navigation is
// instant and animated (Astro's idiomatic multi-page navigation).
import { ClientRouter } from 'astro:transitions';
import '../styles/ui.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import CommandPalette from '../components/islands/CommandPalette';
import ChatConsole from '../components/islands/ChatConsole';
import Breadcrumbs from '../components/islands/Breadcrumbs';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Nothing up my sleeve</title>
    <link rel="icon" type="image/svg+xml" href="/card.svg" />
    <link rel="apple-touch-icon" href="/card.svg" />
  </head>
  <body>
    <Header />
    <!-- where this page sits, from Places down (lib/crumbs.ts): one trail for every page -->
    <Breadcrumbs client:load initialPath={Astro.url.pathname} />
    <slot />
    <!-- ⌘K, on every page: type a model, open its chat (components/islands/CommandPalette) -->
    <CommandPalette client:idle />
    <!-- the chat console: a carved drawer that slides up from the bottom of every page (⌘J) -->
    <ChatConsole client:idle />
    <ClientRouter />
    <!-- One row, one active tab: an island may push a new address without a page load (a canonical
         size address, a discoveries tab), so re-light the header from the live address. The prefixes
         come from lib/nav.ts via Header.astro (data-match), so there is still one source of truth. -->
    <script is:inline>
      (() => {
        const light = () => {
          const raw = location.hash && location.hash.startsWith('#/') ? location.hash.slice(1) : location.pathname;
          const clean = raw.replace(/^#/, '').split('?')[0];
          const path = (clean.length > 1 ? clean.replace(/\/+$/, '') : clean) || '/';
          const tabs = Array.from(document.querySelectorAll('#mainnav a[data-nav]'));
          if (!tabs.length) return;
          let active = null;
          for (const tab of tabs) {
            const prefixes = (tab.getAttribute('data-match') || '').split(',').filter(Boolean);
            if (prefixes.some((p) => path === p || path.startsWith(p + '/'))) { active = tab; break; }
          }
          // settings is the cog's page, not one of the ways in: no tab is lit there (nor on its tabs)
          const settings = path === '/settings' || path.startsWith('/settings/');
          if (!active && !settings) active = tabs.find((tab) => tab.getAttribute('data-nav') === 'places') || null;
          const cog = document.getElementById('settingscog');
          if (cog) { if (settings) cog.setAttribute('aria-current', 'page'); else cog.removeAttribute('aria-current'); }
          for (const tab of tabs) {
            const on = tab === active;
            tab.setAttribute('data-state', on ? 'active' : 'inactive');
            if (on) tab.setAttribute('aria-current', 'page'); else tab.removeAttribute('aria-current');
          }
          // the breadcrumb trail follows the same live address (components/islands/Breadcrumbs)
          window.dispatchEvent(new Event('thorp:navigate'));
        };
        if (!window.__thorpMainNav) {
          window.__thorpMainNav = true;
          const push = history.pushState;
          history.pushState = function (...args) { const out = push.apply(this, args); light(); return out; };
          const replace = history.replaceState;
          history.replaceState = function (...args) { const out = replace.apply(this, args); light(); return out; };
          addEventListener('popstate', light);
          addEventListener('hashchange', light);
          document.addEventListener('astro:page-load', light);
        }
        light();
      })();
    </script>
  </body>
</html>
