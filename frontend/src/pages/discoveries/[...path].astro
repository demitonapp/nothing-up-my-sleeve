---
// Every old /discoveries address (12 November) is sent to its new home in the orbitals (lib/discoveryPaths.ts).
import DiscoveriesMoved from '../../components/DiscoveriesMoved.astro';
import { DISCOVERY_PATHS } from '../../lib/discoveryPaths';

export function getStaticPaths() {
  return DISCOVERY_PATHS.filter((path) => path !== 'cards').map((path) => ({ params: { path } }));
}
const { path } = Astro.params;
---
<DiscoveriesMoved path={`/discoveries/${path}`} />
