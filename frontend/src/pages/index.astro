---
/**
 * The Thorp dashboard: one page, hash-routed (#/classes, #/classes/proxy, #/ships/…, #/voyages, #/discoveries, #/leaderboard, #/shelves, #/sieves), like the Atlas shell in
 * the monorepo. Every panel is filled in the browser from server.py's JSON API and refreshed every
 * 5 s; the build is static and `thorp dash` serves it. The standards are in ../../UI.md.
 */
import '../styles/ui.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Ladder from '../components/Ladder.astro';
import ModelPage from '../components/ModelPage.astro';
import Ship from '../components/Ship.astro';
import Voyages from '../components/Voyages.astro';
import Discoveries from '../components/Discoveries.astro';
import SievesGuide from '../components/SievesGuide.astro';
import Shelves from '../components/Shelves.astro';
import Leaderboard from '../components/Leaderboard.astro';
import Competitor from '../components/Competitor.astro';
import Lab from '../components/Lab.astro';
import Governance from '../components/Governance.astro';
import Bet from '../components/Bet.astro';
import TableTalk from '../components/TableTalk.astro';
import Runs from '../components/Runs.astro';
import Reader from '../components/Reader.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Thorp</title>
  </head>
  <body>
    <Header />
    <main>
      <Ladder />
      <ModelPage />
      <Ship />
      <Runs />
      <Voyages />
      <Discoveries />
      <Leaderboard />
      <Competitor />
      <Lab />
      <Bet />
      <Governance />
      <Shelves />
      <SievesGuide />
      <TableTalk />
    </main>
    <Reader />
    <script>
      import '../scripts/dashboard.js';
    </script>
  </body>
</html>
