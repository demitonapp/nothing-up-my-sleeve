---
/**
 * The harbours (home) and the ships: the ladder of sizes grouped into harbours, one size's page, one
 * ship's page, and every run. This is the first of the multi-page routes — the expeditions, discoveries,
 * leaderboard, governance, bet, library, sieves and foreign pages each live under their own route now.
 * Every panel is filled in the browser from server.py's JSON API and refreshed every 5 s.
 */
import Layout from '../layouts/Layout.astro';
import Ladder from '../components/Ladder.astro';
import ModelPage from '../components/ModelPage.astro';
import Ship from '../components/Ship.astro';
import Runs from '../components/Runs.astro';
import Reader from '../components/Reader.astro';
---

<Layout>
  <main>
    <Ladder />
    <ModelPage />
    <Ship />
    <Runs />
  </main>
  <Reader />
  <script>
    import '../scripts/dashboard.ts';
  </script>
</Layout>
