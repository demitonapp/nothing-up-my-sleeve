---
/**
 * The harbours (home) and the ships: the ladder of sizes grouped into harbours, one size's page, one
 * ship's page, and every run. Each route is its own React island (frontend/src/components/islands),
 * filled from server.py's JSON API; the reader stays here because its book links live across them.
 */
import Layout from '../layouts/Layout.astro';
import Harbours from '../components/islands/Harbours';
import SizePage from '../components/islands/SizePage';
import ShipPage from '../components/islands/ShipPage';
import RunsPage from '../components/islands/RunsPage';
import Reader from '../components/Reader.astro';
---

<Layout>
  <main>
    <Harbours client:load />
    <SizePage client:load />
    <ShipPage client:load />
    <RunsPage client:load />
  </main>
  <Reader />
</Layout>
