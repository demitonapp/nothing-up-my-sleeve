---
// One house of Masaq' Reach at its country's address (12 November, Justin: "/labs/arcee ... will move to
// /masaq/us/arcee"): /masaq/<country>/<key>. The old /labs/<key> stays as an alias. The islands read the
// route; only the one that answers it renders.
import Layout from '../../layouts/Layout.astro';
import Labs from '../../components/islands/Labs';
import LabPage from '../../components/islands/LabPage';

export function getStaticPaths() {
  const houses: [string, string][] = [
    ['us', 'google'], ['us', 'openai'], ['us', 'anthropic'], ['us', 'meta'], ['cn', 'alibaba'],
    ['us', 'microsoft'], ['cn', 'deepseek'], ['cn', 'antgroup'], ['fr', 'mistral'], ['us', 'xai'],
    ['cn', 'moonshot'], ['cn', 'zai'], ['cn', 'minimax'], ['ca', 'cohere'], ['us', 'nvidia'],
    ['cn', 'stepfun'], ['cn', 'bytedance'], ['us', 'thinkingmachines'], ['ae', 'tii'],
    ['us', 'cognition'], ['us', 'arcee'],
  ];
  const paths: string[] = [
    'labs', 'models',
    ...houses.map(([country, key]) => `${country}/${key}`),
    ...houses.map(([country, key]) => `${country}/${key}/models`),
  ];
  for (const band of ['xsmall', 'small', 'medium', 'large']) paths.push(`models/${band}`);
  return paths.map((path) => ({ params: { path } }));
}
---

<Layout>
  <main>
    <Labs client:load />
    <LabPage client:load />
  </main>
</Layout>
