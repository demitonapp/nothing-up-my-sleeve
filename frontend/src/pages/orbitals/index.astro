---
// The orbitals at their own address (12 November, Justin: "/harbours/demiton shouldn't have harbour but
// rather orbital"): Demiton and Masaq' Reach, each a flip card. / still answers the same page; /harbours
// is kept as an alias by the island, which rewrites the address to /orbitals.
import Layout from '../../layouts/Layout.astro';
import Harbours from '../../components/islands/Harbours';
import SizePage from '../../components/islands/SizePage';
import ShipPage from '../../components/islands/ShipPage';
import RunsPage from '../../components/islands/RunsPage';
import Reader from '../../components/Reader.astro';
import { PUBLIC_EDITION } from '../../lib/edition';
---

<Layout>
  <main>
    <Harbours client:load />
    {/* our ships' and runs' islands, and the reader for their books: only Demiton's addresses open them, so the
        public edition (lib/edition.ts) mounts none of them */}
    {!PUBLIC_EDITION && <SizePage client:load />}
    {!PUBLIC_EDITION && <ShipPage client:load />}
    {!PUBLIC_EDITION && <RunsPage client:load />}
  </main>
  {!PUBLIC_EDITION && <Reader />}
</Layout>
