---
// Masaq' Reach's sub-paths under /orbitals/masaq: the Models view and its size bands, and one page per
// house. /masaq/... and /labs/... stay as aliases; the islands read the route.
import Layout from '../../../layouts/Layout.astro';
import Labs from '../../../components/islands/Labs';
import LabPage from '../../../components/islands/LabPage';
import labData from '../../../data/labs.json';
// the houses come from frontend/src/data/labs.json, written from thorp.labs.listed() by
// `python -m thorp.dash.lab_keys`: the cards and the routes are one list, so a card cannot link a
// missing page (12 November: the houses left thorp/labs.py for s4.labs)
export function getStaticPaths() {
  const houses = labData.houses as [string, string][];
  const paths: string[] = [
    'labs', 'research', 'models', 'embeddings',
    // a country's pages (13 November): /us, /us/labs, /us/research, /us/models
    ...[...new Set(houses.map(([country]) => country))].flatMap((cc) => [cc, `${cc}/labs`, `${cc}/research`, `${cc}/models`]),
    ...houses.map(([country, key]) => `${country}/${key}`),
    ...houses.map(([country, key]) => `${country}/${key}/models`),
  ];
  for (const band of ['xsmall', 'small', 'medium', 'large']) paths.push(`models/${band}`);
  return paths.map((path) => ({ params: { path } }));
}
---

<Layout>
  <main>
    <Labs client:load />
    <LabPage client:load />
  </main>
</Layout>
