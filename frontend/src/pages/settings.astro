---
// Settings: the cog in the header. What the dashboard runs on (the disk, the store, the server, the
// switches, the keys), read-only, from /api/settings. This is the first tab, Storage; the other four
// are pages of their own (settings/[...path].astro) so a tab survives a refresh.
import Layout from '../layouts/Layout.astro';
import Settings from '../components/islands/Settings';
---
<Layout>
  <main>
    <Settings client:load />
  </main>
</Layout>
