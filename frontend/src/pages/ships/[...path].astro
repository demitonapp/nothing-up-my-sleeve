---
// Every-ship and direct ship routes for dev (production falls back too). Ship keys are dynamic, so
// only /ships/all is enumerated; other ship pages are reached by their links (the island pushState).
import Layout from '../../layouts/Layout.astro';
import Harbours from '../../components/islands/Harbours';
import SizePage from '../../components/islands/SizePage';
import ShipPage from '../../components/islands/ShipPage';
import RunsPage from '../../components/islands/RunsPage';
import Reader from '../../components/Reader.astro';

export function getStaticPaths() {
  // The rungs are on this page too (9 November), by preset (the canonical identifier) or by class
  // slug (the old aliases the page rewrites), with every tab and sub-view the island links to. Dev has
  // no server fallback, so a sub-view missing here is a 404 when opened directly (10 November: the
  // waypoint and overview sub-tabs 404'd).
  const rungs = ['300k', '1m', '9m', '21m', '50m', '100m', '350m',
    'faces', 'pan', 'augustus', 'speller', 'stylist', 'paragraph', 'invention', 'trader'];
  const tabs = ['overview', 'goals', 'training', 'scoring', 'waypoints', 'sops', 'fitouts', 'bet', 'chat'];
  const scoring = ['maths', 'ask', 'language', 'shapes', 'number', 'physics', 'life', 'return', 'logic', 'versus'];
  const waypoints = ['expected', 'envelope', 'stars'];
  const overview = ['logic-order', 'logic-cause', 'logic-membership', 'logic-proportion', 'logic-counterfactual'];
  const rungPaths: string[] = [];
  for (const p of rungs) {
    rungPaths.push(p);
    for (const t of tabs) rungPaths.push(`${p}/${t}`);
    for (const x of scoring) rungPaths.push(`${p}/scoring/${x}`);
    for (const x of waypoints) rungPaths.push(`${p}/waypoints/${x}`);
    for (const x of overview) rungPaths.push(`${p}/overview/${x}`);
  }
  // /ships/all, and the ships fitting out in the harbour (their cards link here); other ship keys
  // are reached from the tables, and the production server falls back for them.
  const fitting = ['1m:ef2f25caa19b', '1m:1f92d0160513', '1m:0b78123fab41', '1m:ea3af774b02b'];
  // the leaderboard ships' chat tabs, so a direct /ships/<key>/chat is an address in dev too
  const chatKeys = ['300k:2980e0eca706', '50m:e44b67bb9ee2', '21m:60479e54110c', '9m:90636ab5237c', '1m:24e8973b1de9'];
  return ['all', ...rungPaths, ...fitting, ...fitting.map((k) => `${k}/chat`), ...chatKeys.map((k) => `${k}/chat`)]
    .map((path) => ({ params: { path } }));
}

// The per-ship Bet tab is deprecated (10 November): /ships/<preset>/bet forwards to the ship's
// overview. The bet itself lives at /bet (the $100 wager in the header); this tab was the
// Navigator's Wager game, not the bet.
const { path } = Astro.params;
if (path?.endsWith('/bet')) return Astro.redirect(`/ships/${path.slice(0, -4)}`, 301);

// Only the island this address answers is mounted: each one brings its own modules, and mounting all
// four made a size page download the ship and runs islands too (10 November: /ships/300k pulled the
// shipbuilder and four API clients before it could draw a chart).
const kind = path === 'all' ? 'runs' : String(path || '').includes(':') ? 'ship' : 'size';
---
<Layout>
  <main>
    {kind === 'runs' ? <RunsPage client:load /> : kind === 'ship' ? <ShipPage client:load /> : <SizePage client:load initialPath={Astro.url.pathname} />}
  </main>
  <Reader />
</Layout>
