---
// The Ships home *and* the production fallback shell for a ship key that was not built on the Mac
// (dev has no server fallback): the server serves this index.html for /ships/<unknown>, so it must
// mount every island the address could answer. The known /ships/<preset>/... pages are built from
// ships/[...path].astro and mount only the one island they need (10 November: /ships/300k was slow
// because all four islands loaded and the overview pulled Plotly; those pages are now split).
import Layout from '../../layouts/Layout.astro';
import Harbours from '../../components/islands/Harbours';
import SizePage from '../../components/islands/SizePage';
import ShipPage from '../../components/islands/ShipPage';
import RunsPage from '../../components/islands/RunsPage';
import Reader from '../../components/Reader.astro';
---
<Layout>
  <main>
    <Harbours client:load />
    <SizePage client:load />
    <ShipPage client:load />
    <RunsPage client:load />
  </main>
  <Reader />
</Layout>
