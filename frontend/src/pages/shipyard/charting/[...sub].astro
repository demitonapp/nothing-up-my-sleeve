---
// The shipyard's Charting tabs, retired with it (13 November): each forwards to its page in Demiton's discoveries
// (tells to the stars, skills, tests; the old aliases too). The map is lib/discoveryPaths.ts.
import DiscoveriesMoved from '../../../components/DiscoveriesMoved.astro';

export function getStaticPaths() {
  return ['overview', 'skills', 'tests', 'tells', 'stars', 'cards', 'quantum', 'two-facts', 'registry'].map((sub) => ({ params: { sub } }));
}
const { sub } = Astro.params;
---
<DiscoveriesMoved path={`/shipyard/charting/${sub}`} />
