---
// The VSM page (/vsm), a tab under Expeditions: the five systems as five sub-tabs. The island keeps
// the Expeditions sub-tabs on the page (Overview, Queue, Plans, VSM) and reads the route for the
// system tab (/vsm/s2 … /vsm/s5). The old /governance addresses redirect here (astro.config.mjs).
import Layout from '../layouts/Layout.astro';
import Governance from '../components/islands/Governance';
import Reader from '../components/Reader.astro';
---
<Layout>
  <main>
    <Governance client:load />
  </main>
  <Reader />
</Layout>
