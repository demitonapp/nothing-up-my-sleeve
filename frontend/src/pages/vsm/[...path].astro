---
// The VSM's five systems, a page each (12 November): /vsm is the overview (the five cards), /vsm/s1 …
// /vsm/s5 a system's own page; /vsm/control and /vsm/acquisition answer as S3's and S1's. The old
// /governance addresses redirect here (astro.config.mjs). The island reads the route (useRoute).
import Layout from '../../layouts/Layout.astro';
import Governance from '../../components/islands/Governance';
import Reader from '../../components/Reader.astro';

export function getStaticPaths() {
  return ['s1', 's2', 's3', 's4', 's5', 'control', 'acquisition'].map((path) => ({ params: { path } }));
}
---
<Layout>
  <main>
    <Governance client:load />
  </main>
  <Reader />
</Layout>
